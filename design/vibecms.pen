      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "SGNoE",
          "name": "Line",
          "fill": "$fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Design pass: the four screens that decide whether someone stays",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "bKJZk",
          "name": "Line",
          "fill": "$muted-fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Limits v2: a plan cap is guidance, not an error. Neutral surface, foreground title, usage meter, one primary action (Get Cloud). The action that was refused leaves the footer, so there is no second failing click.",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "B1rERT",
          "name": "Line",
          "fill": "$muted-fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Billing v2: one bounded card, two columns: what Free gives you now, what Cloud adds and what it costs today. One filled button; yearly is a quiet link. Table below uses the words Free and Cloud.",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "bDgJH",
          "name": "Line",
          "fill": "$muted-fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Connect v2: a live connection line at the top of Connect. Waiting dot pulses until the first request; then it names the agent and when it last reached the blog.",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "RnOZF",
          "name": "Line",
          "fill": "$muted-fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Onboarding v2: the blog address is visible on the connect step; the Claude connector URL is the first tab; copy no longer says on the right (wrong on phone).",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "xbXZg",
          "name": "Line",
          "fill": "$muted-fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Analytics v2: the free line moves under the numbers, where it is seen, same pattern as the overview line.",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "WgxTh",
          "name": "Line",
          "fill": "$muted-fg",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Rules held: Geist + Geist Mono, green only on primary action, dots, checkmarks. No nested cards. No tier tags.",
          "lineHeight": 1.5,
          "fontFamily": "$sans",
          "fontSize": 14
        }
      ]
