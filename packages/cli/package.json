{
  "name": "vibecms-cli",
  "version": "0.2.0",
  "description": "Command-line client for the vibecms API, built for AI agents.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moinulmoin/vibecms.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vibecms.dev/docs/cli",
  "bugs": {
    "url": "https://github.com/moinulmoin/vibecms/issues"
  },
  "type": "module",
  "bin": {
    "vibecms": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && cp ../../apps/api/openapi.json dist/openapi.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "smoke": "pnpm build && node scripts/smoke-pack.mjs",
    "prepublishOnly": "pnpm smoke",
    "test": "node --test src/index.test.mjs"
  },
  "devDependencies": {
    "@vc/config": "workspace:*",
    "@types/node": "~25.6.2",
    "typescript": "6.0.3"
  }
}
