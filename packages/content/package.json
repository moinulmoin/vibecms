{
  "name": "@vc/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./presented-post": "./src/presented-post.tsx",
    "./public-chrome": "./src/public-chrome.tsx",
    "./styles": "./src/styles/vc-rich-content.css",
    "./styles/presets": "./src/styles/presets.css",
    "./styles/prose": {
      "types": "./src/styles/prose.module.css.d.ts",
      "default": "./src/styles/prose.module.css"
    },
    "./highlight": "./src/highlight.ts",
    "./math": "./src/math.ts",
    "./public-post-list": "./src/public-post-list.tsx",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "tsc",
    "test": "vitest run",
    "gen:css-types": "node scripts/gen-css-dts.mjs src",
    "harness": "vite --config harness/vite.config.ts --port 5199"
  },
  "dependencies": {
    "@shikijs/langs": "4.4.2",
    "@shikijs/themes": "4.4.2",
    "@vc/config": "workspace:*",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "katex": "^0.18.9",
    "rehype-raw": "7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "3.0.3",
    "shiki": "4.4.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vc/ui": "workspace:*",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.11.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
