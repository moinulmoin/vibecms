# Copy to .dev.vars for local vite dev (secrets are not in wrangler.jsonc vars).
TOKEN_PEPPER=generate_with_openssl_rand_hex_32
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32
# Email OTP delivery via Cloudflare Email Sending (omit the token to log codes to the console in dev):
# CLOUDFLARE_EMAIL_API_TOKEN=   # CF API token with Email Sending permission
# EMAIL_FROM=VibeCMS <noreply@yourdomain.com>   # sender on a domain onboarded to Cloudflare Email Sending
# Polar sandbox (hosted mode billing):
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_MONTHLY_PRODUCT_ID=
