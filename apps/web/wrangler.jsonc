{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecms-dev",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibecms_dev",
      "database_id": "869d397e-f61f-4206-b8d8-ad3255c415f9",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vibecms-assets"
    }
  ],
  "routes": [
    // Dev mirrors prod on a SEPARATE zone (basedui.dev) to avoid the *.vibecms.dev wildcard collision.
    { "pattern": "basedui.dev", "custom_domain": true },
    { "pattern": "app.basedui.dev", "custom_domain": true },
    // Test tenant blog; arbitrary tenants later need a proxied *.basedui.dev DNS record + a zone_name route.
    { "pattern": "demo.basedui.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "https://app.basedui.dev",
    "BETTER_AUTH_URL": "https://app.basedui.dev",
    "PUBLIC_BLOG_DOMAIN": "basedui.dev",
    "SELF_HOSTED": "false",
    "EMAIL_FROM": "vibecms <hey@vibecms.dev>",
    "POLAR_PRODUCT_ID": "product_dev_placeholder",
    "POLAR_SERVER": "sandbox",
    "CLOUDFLARE_ACCOUNT_ID": "b033fb898b354c8292ce5769505e7d36"
  },
  "env": {
    // Production hosts: vibecms.dev (marketing) + app.vibecms.dev (dashboard + auth + agent APIs) + *.vibecms.dev/* (tenant blogs).
    // Secrets (TOKEN_PEPPER, BETTER_AUTH_SECRET, CLOUDFLARE_EMAIL_API_TOKEN, POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET) are set via `wrangler secret put --env production`.
    "production": {
      "name": "vibecms-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vibecms_prod",
          "database_id": "98ac8ee4-6b93-4500-b2a0-f8011516fe75",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "vibecms-assets-prod"
        }
      ],
      "routes": [
        // Marketing host (apex) - Cloudflare auto-provisions the apex DNS record on deploy
        { "pattern": "vibecms.dev", "custom_domain": true },
        // App host: dashboard (/dashboard) + auth (/login, /api/auth) + agent APIs (/mcp, /api/v1)
        { "pattern": "app.vibecms.dev", "custom_domain": true },
        // Tenant blog subdomains - requires a proxied *.vibecms.dev DNS record added manually
        // (cannot use custom_domain for wildcards; zone_name routes a pattern instead)
        { "pattern": "*.vibecms.dev/*", "zone_name": "vibecms.dev" }
      ],
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://app.vibecms.dev",
        "BETTER_AUTH_URL": "https://app.vibecms.dev",
        "PUBLIC_BLOG_DOMAIN": "vibecms.dev",
        "EMAIL_FROM": "vibecms <hey@vibecms.dev>",
        "POLAR_SERVER": "production",
        "POLAR_PRODUCT_ID": "305d416c-5ec6-4517-b5ea-f21fdc5b34b3",
        "POLAR_YEARLY_PRODUCT_ID": "4b453905-d966-4176-8e56-c929f47ad436",
        "CLOUDFLARE_ACCOUNT_ID": "b033fb898b354c8292ce5769505e7d36"
      }
    }
  }
}
