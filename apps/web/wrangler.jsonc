{
  // Schema reference for wrangler configuration
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker name (dev worker)
  "name": "vibecms",

  // Entry point for your worker
  "main": "src/worker.tsx",

  // Compatibility settings
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Assets configuration
  "assets": {
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibecms_dev",
      "database_id": "869d397e-f61f-4206-b8d8-ad3255c415f9",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vibecms-assets"
    }
  ],

  // Observability settings
  "observability": {
    "enabled": true
  },

  // Top level = the DEVELOPMENT environment (worker "vibecms", deployed from the `dev`
  // branch with `wrangler deploy`). These live in code, not the dashboard, because
  // `wrangler deploy` overwrites the worker's remote config on every deploy.
  // Production overrides go under `env.production` (added at launch) and deploy with
  // `wrangler deploy --env production`, so dev and prod never diverge per branch.
  "routes": [{ "pattern": "dev.vibecms.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "https://dev.vibecms.dev",
    "BETTER_AUTH_URL": "https://dev.vibecms.dev",
    "PUBLIC_BLOG_DOMAIN": "dev.vibecms.dev",
    "SELF_HOSTED": "false",
    "POLAR_PRODUCT_ID": "product_dev_placeholder",
    "POLAR_SERVER": "sandbox"
  }
}
