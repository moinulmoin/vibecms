{
  "name": "@vc/web",
  "version": "1.0.0",
  "description": "VibeCMS web worker",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "npm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && npm run clean && npm run build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "typecheck": "tsc",
    "lint": "tsc"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.47.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@vc/config": "workspace:*",
    "@vc/core": "workspace:*",
    "@vc/db": "workspace:*",
    "@vc/ui": "workspace:*",
    "@vc/validators": "workspace:*",
    "better-auth": "^1.2.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "rwsdk": "1.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.33.2",
    "@cloudflare/workers-types": "4.20260426.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "~25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "~7.3.2",
    "wrangler": "4.85.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
