{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecms-public-dev",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "vibecms_page_views_dev"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibecms_dev",
      "database_id": "869d397e-f61f-4206-b8d8-ad3255c415f9",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vibecms-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "services": [
    {
      "binding": "API",
      "service": "vibecms-api-dev"
    }
  ],
  "routes": [
    { "pattern": "basedui.dev", "custom_domain": true },
    { "pattern": "*.basedui.dev/*", "zone_name": "basedui.dev" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "https://app.basedui.dev",
    "PUBLIC_BLOG_DOMAIN": "basedui.dev",
    "SELF_HOSTED": "false"
  },
  "env": {
    "production": {
      "name": "vibecms-public-prod",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "vibecms_page_views_prod"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vibecms_prod",
          "database_id": "98ac8ee4-6b93-4500-b2a0-f8011516fe75",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "vibecms-assets-prod"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "cache": {
        "enabled": true
      },
      "services": [
        {
          "binding": "API",
          "service": "vibecms-prod"
        }
      ],
      "routes": [
        { "pattern": "vibecms.dev", "custom_domain": true },
        { "pattern": "*.vibecms.dev/*", "zone_name": "vibecms.dev" }
      ],
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://app.vibecms.dev",
        "PUBLIC_BLOG_DOMAIN": "vibecms.dev",
        "SELF_HOSTED": "false"
      }
    }
  }
}