---
import "../styles/global.css";
import "../styles/landing.css";
import { BRAND } from "@vc/config";
import { seo } from "../lib/landing-seo";
import { marketingJsonLd } from "../lib/agent-pages";
import { LandingHeader } from "../components/landing/header-nav";
import { LandingFooter } from "../components/landing/cta-footer";
import { DotGrid, Glow } from "../components/landing/primitives";
import geistFontUrl from "@vc/ui/assets/fonts/Geist-Variable.woff2";
import geistMonoFontUrl from "@vc/ui/assets/fonts/GeistMono-Variable.woff2";
import marketingInteractionsUrl from "../scripts/marketing-interactions.js?url";

interface Props {
  ogImage?: string;
  loginUrl: string;
  apiDocsUrl: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  ogImage,
  loginUrl,
  apiDocsUrl,
  title = `${BRAND.name}: ${BRAND.tagline.replace(/\.$/, "")}`,
  description = BRAND.description,
  noindex = false,
} = Astro.props;
const canonical = noindex ? undefined : new URL("/", Astro.url).href;
const meta = seo({
  title,
  description,
  image: ogImage,
  url: canonical,
  siteName: BRAND.name,
});
const jsonLd = canonical ? marketingJsonLd(canonical) : undefined;
---
<!doctype html>
<html lang="en" class="dark" data-vc-app-login={loginUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c100e" />
    <meta name="color-scheme" content="dark" />
    {meta.map((tag) =>
      "title" in tag ? <title>{String(tag.title)}</title> :
      "name" in tag && tag.name ? <meta name={String(tag.name)} content={String(tag.content ?? "")} /> :
      "property" in tag && tag.property ? <meta property={String(tag.property)} content={String(tag.content ?? "")} /> :
      null
    )}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={geistFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={geistMonoFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <a
      href="#main"
      class="fixed left-4 top-4 z-[100] -translate-y-[220%] rounded-xl bg-popover px-4 py-3 font-mono text-[13px] font-medium text-foreground no-underline shadow-lg ring-1 ring-[color:var(--hairline)] transition-transform duration-150 focus-visible:translate-y-0"
    >
      Skip to content
    </a>
    <!-- overflow-clip (not hidden) keeps the sticky header working. -->
    <div class="dark relative min-h-dvh overflow-clip bg-background text-foreground">
      <DotGrid className="pointer-events-none absolute inset-x-0 top-0 z-0 h-[1100px] opacity-90" />
      <Glow className="pointer-events-none absolute -top-[300px] left-1/2 z-0 size-[min(760px,108vw)] -translate-x-1/2 opacity-40" />
      <div class="relative z-[1]">
        <LandingHeader loginUrl={loginUrl} />
        <main id="main" tabindex="-1" class="outline-none">
          <slot />
        </main>
        <LandingFooter loginUrl={loginUrl} apiDocsUrl={apiDocsUrl} />
      </div>
    </div>
    <script is:inline src={marketingInteractionsUrl} defer></script>
  </body>
</html>
