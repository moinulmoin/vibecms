---
import "../styles/global.css";
import "../styles/landing.css";
import { BRAND, PRICING } from "@vc/config";
import { seo } from "../lib/landing-seo";
import geistFontUrl from "@vc/ui/assets/fonts/Geist-Variable.woff2";
import geistMonoFontUrl from "@vc/ui/assets/fonts/GeistMono-Variable.woff2";

interface Props {
  ogImage?: string;
  loginUrl: string;
}
const { ogImage, loginUrl } = Astro.props;
const canonical = new URL("/", Astro.url).href;
const title = `${BRAND.name}: ${BRAND.tagline.replace(/\.$/, "")}`;
const meta = seo({
  title,
  description: BRAND.description,
  image: ogImage,
  url: canonical,
  siteName: BRAND.name,
});
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: BRAND.name,
  url: canonical,
  description: BRAND.description,
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: String(PRICING.monthlyUsd), priceCurrency: "USD" },
}).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en" class="dark" data-vc-app-login={loginUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c100e" />
    <meta name="color-scheme" content="dark" />
    {meta.map((tag) =>
      "title" in tag ? <title>{String(tag.title)}</title> :
      "name" in tag && tag.name ? <meta name={String(tag.name)} content={String(tag.content ?? "")} /> :
      "property" in tag && tag.property ? <meta property={String(tag.property)} content={String(tag.content ?? "")} /> :
      null
    )}
    <link rel="canonical" href={canonical} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={geistFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={geistMonoFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <a
      href="#main"
      class="fixed left-4 top-4 z-[100] -translate-y-[220%] rounded-xl bg-popover px-4 py-3 font-mono text-[13px] font-medium text-foreground no-underline shadow-lg ring-1 ring-[color:var(--hairline)] transition-transform duration-150 focus-visible:translate-y-0"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>