---
import LandingLayout from "../../layouts/LandingLayout.astro";
import { BRAND } from "@vc/config";
import { MarketingNotFound } from "../../components/landing/not-found";
import { isDirectInternalRootHit } from "../../lib/internal-root";
import { markdownNotFound } from "../../lib/agent-discovery";
import { appApiDocsUrl, appLoginUrl } from "../../lib/landing-links";
import { isMarketingHost } from "../../server/public-blog";
import { publicRuntimeEnv } from "../../server/runtime";

// Internal entry only: marketing-host routes (404, [postSlug], docs/[...slug],
// tag/[tag]) `Astro.rewrite("/internal/not-found")` unknown paths here so the
// branded page keeps its own module graph and tenant 404s never load marketing
// CSS. Direct hits stay a plain 404.
const env = publicRuntimeEnv(Astro);
if (isDirectInternalRootHit(Astro.originPathname, Astro.url.pathname) || env.selfHosted || !isMarketingHost(Astro.request, env)) {
  return new Response("Not found", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
}
const missing = Astro.request.headers.get("accept")?.includes("text/markdown") ? markdownNotFound() : null;
if (missing) return missing;
Astro.response.status = 404;
Astro.response.headers.set("Vary", "Accept");
Astro.response.headers.set("cache-control", "no-store");
---
<LandingLayout
  loginUrl={appLoginUrl(env.appUrl)}
  apiDocsUrl={appApiDocsUrl(env.appUrl)}
  title={`Page not found | ${BRAND.name}`}
  description="The requested page was not found. Start from the home page or the docs."
  noindex
>
  <MarketingNotFound />
</LandingLayout>
