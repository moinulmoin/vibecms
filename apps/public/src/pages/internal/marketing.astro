---
import LandingLayout from "../../layouts/LandingLayout.astro";
import { AgentSurface } from "../../components/landing/agent-surface";
import { AgentsDemo } from "../../components/landing/agents-demo";
import { CtaFooter } from "../../components/landing/cta-footer";
import { BlogFeatures } from "../../components/landing/blog-features";
import { ControlSection } from "../../components/landing/control-section";
import { FaqAccordion } from "../../components/landing/faq-accordion";
import { HeaderHero } from "../../components/landing/header-hero";
import { HostingPricing } from "../../components/landing/hosting-pricing";
import { DotGrid, Glow } from "../../components/landing/primitives";
import { isDirectInternalRootHit } from "../../lib/internal-root";
import { marketingHomeLinks } from "../../lib/agent-discovery";
import { appApiDocsUrl, appLoginUrl } from "../../lib/landing-links";
import { publicOrigin } from "../../server/public-url";
import { publicRuntimeEnv } from "../../server/runtime";
import marketingInteractionsUrl from "../../scripts/marketing-interactions.js?url";

// Internal entry only — reachable via rewrite from `/`. Direct hits 404 so the
// path stays non-indexable and never becomes a public canonical URL.
if (isDirectInternalRootHit(Astro.originPathname, Astro.url.pathname)) {
  return Astro.request.headers.get("accept")?.includes("text/markdown") ? markdownNotFound() : new Response("Not found", { status: 404 });
}

const env = publicRuntimeEnv(Astro);
const origin = publicOrigin(Astro.request.url);
if (Astro.request.headers.get("accept")?.includes("text/markdown")) {
  return new Response(marketingMarkdown(env.appUrl), { headers: { "content-type": "text/markdown; charset=utf-8", vary: "Accept", link: marketingHomeLinks(origin, env.appUrl) } });
}
Astro.response.headers.set("Vary", "Accept");
Astro.response.headers.set("Link", marketingHomeLinks(origin, env.appUrl));
const loginUrl = appLoginUrl(env.appUrl);
const apiDocsUrl = appApiDocsUrl(env.appUrl);
const ogImage = `${publicOrigin(Astro.request.url)}/brand/og.png`;
---
<LandingLayout loginUrl={loginUrl} ogImage={ogImage}>
  <main id="main" tabindex="-1" class="dark relative min-h-dvh overflow-hidden bg-background text-foreground">
    <DotGrid className="pointer-events-none fixed inset-0 z-0 opacity-90" />
    <Glow className="pointer-events-none fixed -top-[32%] left-1/2 z-0 size-[min(760px,108vw)] -translate-x-1/2 opacity-40" />
    <div class="relative z-[1]">
      <HeaderHero loginUrl={loginUrl} />
      <AgentsDemo apiDocsUrl={apiDocsUrl} />
      <AgentSurface apiDocsUrl={apiDocsUrl} />
      <ControlSection />
      <BlogFeatures />
      <HostingPricing loginUrl={loginUrl} />
      <FaqAccordion />
      <CtaFooter loginUrl={loginUrl} apiDocsUrl={apiDocsUrl} />
    </div>
  </main>
  <script is:inline src={marketingInteractionsUrl} defer></script>
</LandingLayout>
