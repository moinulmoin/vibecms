---
import Base from '../../layouts/Base.astro';
import { PublicBlogPostView, loadPostHighlighter, siteDocumentProps } from '../../components/PublicBlogPages';
import { loadPrivatePreview, previewNotFound, previewResponseHeaders } from '../../server/preview';
import { isPausedSite } from '../../server/public-blog-data';
import { pausedBlogResponse } from '../../server/paused-blog';
import { publicDb, publicRuntimeEnv } from '../../server/runtime';

for (const [name, value] of Object.entries(previewResponseHeaders)) Astro.response.headers.set(name, value);
const token = Astro.params.token ?? '';
const preview = await loadPrivatePreview(publicDb(Astro), Astro.request, token, publicRuntimeEnv(Astro));
// A paused blog shares nothing, not even through its private preview link.
if (preview && isPausedSite(preview.data.site)) return pausedBlogResponse(Astro.request);
const missing = preview === null ? previewNotFound() : null;
if (missing) return missing;
const { data, versionNumber } = preview!;
const { themeAttrs, fontId } = siteDocumentProps(data.site);
const highlighter = await loadPostHighlighter(data.post.content_markdown);
---
<Base title={`${data.post.title} · Preview`} robots="noindex, nofollow" themeAttrs={themeAttrs} fontId={fontId} faviconAssetId={data.site.favicon_asset_id}>
  <div role="status" style="position:sticky;top:0;z-index:20;padding:.75rem 1rem;text-align:center;background:#272727;color:#fff;font:600 .875rem/1.5 system-ui,sans-serif">
    Preview — not published · v{versionNumber}
  </div>
  <PublicBlogPostView data={data} highlighter={highlighter} />
</Base>
