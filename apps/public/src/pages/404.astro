---
import { markdownNotFound } from "../lib/agent-discovery";
import { isMarketingHost } from "../server/public-blog";
import { publicRuntimeEnv } from "../server/runtime";
const missing = Astro.request.headers.get("accept")?.includes("text/markdown") ? markdownNotFound() : null;
if (missing) return missing;
const env = publicRuntimeEnv(Astro);
// Keep shared landing chrome in the internal entry's module graph so tenant
// misses retain their independent document and never import marketing styles.
if (!env.selfHosted && isMarketingHost(Astro.request, env)) return Astro.rewrite("/internal/not-found");
Astro.response.status = 404;
Astro.response.headers.set("Vary", "Accept");
const basePath = Astro.locals.publicLocation?.basePath ?? "";
const home = basePath || "/";
---
<!doctype html><html lang="en" data-vc-base={basePath || undefined}><head><meta charset="utf-8" /><title>Not found</title></head><body><main><h1>Not found</h1><p>The requested page was not found. <a href={home}>Go home</a> or read <a href={`${basePath}/llms.txt`}>llms.txt</a>.</p></main></body></html>
