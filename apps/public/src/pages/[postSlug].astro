---
import Base from "../layouts/Base.astro";
import { PublicBlogPostView } from "../components/PublicBlogPages";
import {
  handlePublicPostByHostGet,
  loadPublicPostByHost,
  publicHtmlResponseHeaders,
} from "../server/public-blog";
import { buildPostHeadContent } from "../lib/seo-meta";
import { publicDb, publicRuntimeEnv } from "../server/runtime";

const env = publicRuntimeEnv(Astro);
const db = publicDb(Astro);
const postSlug = Astro.params.postSlug;
const early = await handlePublicPostByHostGet(db, Astro.request, postSlug, env);
if (early) return early;

const blog = await loadPublicPostByHost(db, Astro.request, postSlug, env);
if (!blog) {
  return new Response("Not found", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
}

Astro.cache.set({ maxAge: 300, swr: 86400, tags: blog.cacheTags });
for (const [key, value] of Object.entries(publicHtmlResponseHeaders(blog.site, env, blog.cacheTags))) {
  Astro.response.headers.set(key, value);
}

const head = buildPostHeadContent({
  post: blog.post,
  site: blog.site,
  canonicalUrl: blog.canonicalUrl,
  origin: blog.origin,
  indexable: blog.indexable,
});
const titleEntry = head.meta.find((entry) => "title" in entry);
const metaEntries = head.meta.filter((entry) => "name" in entry || "property" in entry);
---
<Base>
  <Fragment slot="head">
    {titleEntry && "title" in titleEntry ? <title>{String(titleEntry.title)}</title> : null}
    {metaEntries.map((entry) => {
      if ("name" in entry && entry.name && entry.content) {
        return <meta name={String(entry.name)} content={String(entry.content)} />;
      }
      if ("property" in entry && entry.property && entry.content) {
        return <meta property={String(entry.property)} content={String(entry.content)} />;
      }
      return null;
    })}
    {head.links.map((link) => <link rel={String(link.rel)} href={String(link.href)} />)}
    {head.scripts.map((script) => <script is:inline type={script.type} set:html={script.children} />)}
  </Fragment>
  <PublicBlogPostView data={blog} />
  <script is:inline src="/scripts/page-view.js" data-post-slug={blog.post.slug} defer></script>
</Base>