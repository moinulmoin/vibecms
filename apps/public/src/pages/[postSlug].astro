---
import Base from "../layouts/Base.astro";
import { PublicBlogPostView, loadPostHighlighter, PublicNotFoundView, siteDocumentProps } from "../components/PublicBlogPages";
import {
  handlePublicPostByHostGet,
  loadPublicPostForSite,
  matchCachedPublicPostHtml,
  publicHtmlResponseHeaders,
  publicPostRedirect,
  isMarketingHost,
} from "../server/public-blog";
import { buildPostHeadContent } from "../lib/seo-meta";
import { resolveSite } from "../server/public-blog-data";
import { publicDb, publicRuntimeEnv } from "../server/runtime";
import { publicLocationRequest, publicUrl, type PublicLocation } from "../server/public-location";
import pageViewScriptUrl from "../scripts/page-view.js?url";
import { markdownNotFound } from "../lib/agent-discovery";

const env = publicRuntimeEnv(Astro);
if (Astro.params.postSlug === "about" && !env.selfHosted && isMarketingHost(Astro.request, env)) {
  return Astro.rewrite("/internal/about");
}
const db = publicDb(Astro);
const postSlug = Astro.params.postSlug;
// Customer-facing location for this request (direct = request origin; proxied
// subpath = customer origin + /blog). publicPath is the stripped blog path.
const location: PublicLocation = Astro.locals.publicLocation ?? {
  origin: new URL(Astro.request.url).origin,
  basePath: "",
  assetOrigin: new URL(Astro.request.url).origin,
  proxied: false,
};
const publicPath = Astro.locals.publicPath ?? Astro.url.pathname;
// Producers see a request whose URL is the customer-facing location URL.
const pubRequest = publicLocationRequest(Astro.request, location, publicPath);
// Markdown Accept/.md/?format=md runs before any HTML page-cache lookup.
const early = await handlePublicPostByHostGet(db, pubRequest, postSlug, env, location);
if (early) return early;

// Resolve the current site entitlement before serving an HTML cache hit. This
// keeps revoked/expired custom domains out of the cache path and ensures free
// default domains render their noindex metadata instead of reusing a paid hit.
const cacheSite = await resolveSite(Astro.request, db, env);
if (!cacheSite) {
  const markdownMissing = Astro.request.headers.get("accept")?.includes("text/markdown") ? markdownNotFound() : null;
  if (markdownMissing) return markdownMissing;
  if (!env.selfHosted && isMarketingHost(Astro.request, env)) return Astro.rewrite("/internal/not-found");
  return new Response("Not found", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
}
if (cacheSite.effective_entitlement.effective) {
  const cachedHtml = await matchCachedPublicPostHtml(pubRequest, cacheSite.id);
  if (cachedHtml) return cachedHtml;
}

const blog = await loadPublicPostForSite(db, location, cacheSite, postSlug, env);
const { themeAttrs: siteThemeAttrs, fontId } = siteDocumentProps(cacheSite);
if (!blog) {
  if (postSlug) {
    const redirect = await publicPostRedirect(db, cacheSite, postSlug, pubRequest, env, location.basePath);
    if (redirect) return redirect;
  }
  Astro.response.status = 404;
  Astro.response.headers.set("cache-control", "no-store");
}

if (blog) {
  const markdownAlternateHref = publicUrl(location, `/${blog.post.slug}.md`);
  for (const [key, value] of Object.entries(
    publicHtmlResponseHeaders(blog.site, env, blog.cacheTags, {
      markdownAlternateHref,
    }),
  )) {
    Astro.response.headers.set(key, value);
  }
}

const head = blog
  ? buildPostHeadContent({
      post: blog.post,
      site: blog.site,
      canonicalUrl: blog.canonicalUrl,
      origin: blog.origin,
      basePath: blog.basePath,
      assetOrigin: blog.assetOrigin,
      indexable: blog.indexable,
      generatedCards: env.generatedCards,
    })
  : { meta: [], links: [], scripts: [] };
const titleEntry = head.meta.find((entry) => "title" in entry);
const metaEntries = head.meta.filter((entry) => "name" in entry || "property" in entry);
const highlighter = blog ? await loadPostHighlighter(blog.post.content_markdown) : null;
---
{!blog ? (
<Base title={`Not found · ${cacheSite.name}`} robots="noindex" themeAttrs={siteThemeAttrs} fontId={fontId} feedHref={`${location.basePath}/feed.xml`} feedTitle={cacheSite.name} faviconAssetId={cacheSite.favicon_asset_id}>
  <PublicNotFoundView site={cacheSite} basePath={location.basePath} assetOrigin={location.proxied ? location.assetOrigin : ""} />
</Base>
) : (
<Base themeAttrs={siteThemeAttrs} fontId={fontId} feedHref={`${location.basePath}/feed.xml`} feedTitle={blog.site.name} faviconAssetId={blog.site.favicon_asset_id}>
  <Fragment slot="head">
    {titleEntry && "title" in titleEntry ? <title>{String(titleEntry.title)}</title> : null}
    {metaEntries.map((entry) => {
      if ("name" in entry && entry.name && entry.content) {
        return <meta name={String(entry.name)} content={String(entry.content)} />;
      }
      if ("property" in entry && entry.property && entry.content) {
        return <meta property={String(entry.property)} content={String(entry.content)} />;
      }
      return null;
    })}
    {head.links.map((link) => <link rel={String(link.rel)} href={String(link.href)} type={link.type ? String(link.type) : undefined} />)}
    {head.scripts.map((script) => <script is:inline type={script.type} set:html={script.children} />)}
  </Fragment>
  <PublicBlogPostView data={blog} highlighter={highlighter} />
  <script is:inline src={pageViewScriptUrl} data-post-slug={blog.post.slug} defer></script>
</Base>
)}
