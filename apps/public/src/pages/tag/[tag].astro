---
import Base from "../../layouts/Base.astro";
import { PublicBlogIndexView, publicPageCanonicalPath, requestedPublicPage, siteDocumentProps } from "../../components/PublicBlogPages";
import { resolveSocialImage } from "../../lib/seo-meta";
import { loadPublicTagByHost, publicListingResponseHeaders } from "../../server/public-blog";
import { publicDb, publicRuntimeEnv } from "../../server/runtime";
import { publicOrigin } from "../../server/public-url";
import { publicBaseUrl, publicUrl, type PublicLocation } from "../../server/public-location";
import { listingMarkdown } from "../../lib/agent-pages";
import { markdownNotFound } from "../../lib/agent-discovery";

const env = publicRuntimeEnv(Astro);
const location: PublicLocation = Astro.locals.publicLocation ?? {
  origin: publicOrigin(Astro.request.url),
  basePath: "",
  assetOrigin: publicOrigin(Astro.request.url),
  proxied: false,
};
const tag = Astro.params.tag ?? "";
const blog = await loadPublicTagByHost(publicDb(Astro), Astro.request, tag, env, requestedPublicPage(Astro.url.searchParams.get("page")), location);
if (!blog) {
  const markdownMissing = Astro.request.headers.get("accept")?.includes("text/markdown") ? markdownNotFound() : null;
  if (markdownMissing) return markdownMissing;
  return new Response("Not found", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
}
if (Astro.request.headers.get("accept")?.includes("text/markdown")) {
  const markdown = new Response(listingMarkdown(blog, publicBaseUrl(location)), { headers: { ...publicListingResponseHeaders(blog.site, env), "content-type": "text/markdown; charset=utf-8", vary: "Accept" } });
  if (markdown) return markdown;
}
for (const [key, value] of Object.entries(publicListingResponseHeaders(blog.site, env))) {
  Astro.response.headers.set(key, value);
}
const title = `Posts tagged ${tag} - ${blog.site.name}`;
const description = blog.site.default_seo_description || blog.site.description || undefined;
const socialImage = resolveSocialImage(location.assetOrigin, null, blog.site, env.generatedCards);
const page = blog.page ?? 1;
const canonical = publicUrl(location, publicPageCanonicalPath(`/tag/${encodeURIComponent(tag)}`, page));
const { themeAttrs, fontId } = siteDocumentProps(blog.site);
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  socialImage={socialImage}
  robots={!blog.indexable ? "noindex,nofollow" : undefined}
  themeAttrs={themeAttrs} fontId={fontId}
  feedHref={`${location.basePath}/feed.xml`}
  feedTitle={blog.site.name} faviconAssetId={blog.site.favicon_asset_id}
>
  <PublicBlogIndexView data={blog} page={page} />
</Base>
