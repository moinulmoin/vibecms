---
import Base from "../../layouts/Base.astro";
import { PublicBlogIndexView } from "../../components/PublicBlogPages";
import { loadPublicTagByHost, publicHtmlResponseHeaders } from "../../server/public-blog";
import { siteCacheTag } from "../../server/public-blog-cache";
import { publicDb, publicRuntimeEnv } from "../../server/runtime";

const env = publicRuntimeEnv(Astro);
const tag = Astro.params.tag ?? "";
const blog = await loadPublicTagByHost(publicDb(Astro), Astro.request, tag, env);
if (!blog) {
  return new Response("Not found", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
}
Astro.cache.set({ maxAge: 300, swr: 86400, tags: [siteCacheTag(blog.site.id)] });
for (const [key, value] of Object.entries(publicHtmlResponseHeaders(blog.site, env, [siteCacheTag(blog.site.id)]))) {
  Astro.response.headers.set(key, value);
}
---
<Base title={`Posts tagged ${tag} - ${blog.site.name}`} robots={!blog.indexable ? "noindex,nofollow" : undefined}>
  <PublicBlogIndexView data={blog} />
</Base>